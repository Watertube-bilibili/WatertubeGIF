{
  "apiType": "stageMode",
  "buildOption": {
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "debug",
      "externalNativeOptions": {
        "abiFilters": [
          "arm64-v8a",
          "x86_64"
        ]
      },
      "nativeLib": {
        "filter": {
          "excludes": [
            "**/armeabi-v7a/**"
          ]
        }
      }
    },
    {
      "name": "release",
      "externalNativeOptions": {
        "abiFilters": [
          "arm64-v8a"
        ]
      },
      "nativeLib": {
        "filter": {
          "excludes": [
            "**/armeabi-v7a/**",
            "**/x86_64/**"
          ]
        }
      },
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest",
    }
  ]
}
